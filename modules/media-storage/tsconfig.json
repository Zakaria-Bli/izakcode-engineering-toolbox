{
  "extends": "@toolbox/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@toolbox/media-storage": ["./index.ts"],
      "@toolbox/media-storage/*": ["./src/*/index.ts"]
    },
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["index.ts", "src/**/*.ts", "tests/**/*.ts", "examples/**/*.ts"],
  "exclude": ["build", "coverage", "dist", "node_modules"]
}
